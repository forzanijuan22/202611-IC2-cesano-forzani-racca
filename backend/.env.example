# ─── Variables de entorno del backend (ejecución local sin Docker) ───────────
# Copiar este archivo a .env:   cp .env.example .env   (Windows: copy .env.example .env)
# Ninguna variable es secreta: el broker es anónimo y la base es SQLite local.
# Si .env no existe, el backend usa exactamente estos valores por defecto.

# MQTT Broker
MQTT_BROKER=localhost
MQTT_PORT=1883
# Prefijo común de los tópicos: <base>/telemetria, <base>/estado, <base>/alerta
MQTT_TOPIC_BASE=campus/tanque1

# Servidor FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Base de datos SQLite (vacío = backend/iot_campus.db)
DB_PATH=
